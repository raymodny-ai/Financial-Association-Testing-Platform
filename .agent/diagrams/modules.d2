# 模块图（从当前代码结构派生，T20 后刷新）

packages: {
  schemas: "packages/schemas\nZod 契约唯一来源"
  shared: "packages/shared\nAppError 族"
  ui: "packages/ui\n设计 Token（tokens.ts/css）"
}

services: {
  api: "services/api\nExpress 5 网关" {
    presentation: "routes(tasks 含 run/results、files、templates 保存/列表/删除) + middleware(workspace/error-handler/security：helmet+限流+CORS+请求ID+UUID防护) + static(T20 同源托管 web 产物 + SPA 回退，WEB_DIST_DIR 可关)"
    domain: "DataProvider 契约 + provider-registry + analysis-runner 任务运行编排 + prompt-renderer + llm-service 编排"
    infrastructure: "adapters(yahoo/stooq/csv-parse/llm-http) + repositories(task/file/result+panel/llm_artifacts/template) + migrate/db + llm-config/prompt-assets/llm-runner + logger(JSON 行结构化日志)"
  }
  analysis-engine: "services/analysis-engine\n纯函数分析引擎" {
    transform: "派生变换 pct/log/diff"
    align: "日期交集对齐"
    binning: "分箱 fit/assign + quantileLinear"
    pipeline: "prepareDataset 编排"
    chi2: "chi2sf（jstat 卡方 CDF 包装）"
    chi-square: "独立性/拟合优度/同质性三检验 + 适用性报告"
    chi-square-dataset: "pairwiseChiSquare：PreparedDataset → 列联表编排；goodnessOfFitScan：逐别名拟合优度（S1，参考期零概率箱记 skipped）"
    student-t: "studentTSf（df≤2 闭式解 / df≥3 jstat）"
    correlation: "pearsonTest / spearmanTest（平均秩）"
    mutual-information: "MI 定义式 + 等频分箱估计 + 播种置换检验"
    hsic: "hsicTest：核独立性检验（迹展开式 + 中位数带宽 + 播种置换），H2"
    continuous-registry: "可插拔注册表（pearson/spearman/mutual_information/hsic）"
    correction: "多重检验校正 bonferroni/bh/by + correctAndMark"
    rolling: "planWindows 调度 + rollingWindowTests 默认四法滚动重算（hsic 可选扩展法，退化记 skipped）"
    lag: "lagScan：[-maxLag,+maxLag] 全整数滞后 Pearson 扫描（PRD 模块 H）"
    audit: "auditSeries 六类审计 + 双源对账 + pass/warn/fail 判定"
    llm-context: "buildLlmContext：TaskConfig+ResultTable+AuditTable → LlmContext 12 字段摘要 + 安全约束旗标"
  }
}

apps: {
  web: "apps/web\nReact + Vite + AntD\nG7 路由懒加载 + vendor 分割" {
    home: "HomePage 新建分析向导（五步 Steps，safeParse 校验；G6 模板条载入/删除 + 保存为模板 + /?clone 预填；G11 派生序列编辑器；G12 CSV 第二文件双源审计；G13 研究问题）"
    results: "ResultsPage 三栏结果页（.layout-results + 风险固定条 + 七 Tab：分类/连续/滚动/滞后/审计/LLM/原始导出 + 导出）"
    lag-chart: "LagCurveChart 零依赖 SVG 滞后曲线图（与表格双视图，PRD 模块 H）"
    history: "HistoryPage 任务列表（状态标签 + 重跑 + 复制分析）"
    lib: "lib/api.ts fetch 封装（credentials:'include' + Zod 出参校验，含 panel 快照） + lib/export.ts 下载原语 + lib/export-report.ts 01~15 编号导出生成器"
  }
}

infra: {
  db: "infra/db\n迁移 SQL（004 lag ±60、005 run_panels 导出面板快照、006 config_templates 分析模板）+ 本地 PostgreSQL 启停脚本"
  deploy: "render.yaml + docs/DEPLOY.md（含 G9 free PG 到期迁移双路径）+ .github/workflows/ci.yml\nT20 Render Blueprint 同源单服务 + free PG + GitHub Actions CI"
}

prompts: "prompts/\nLLM 模板 + output_schema.json（T16 loadPromptAssets 消费；G8 loadOutputSchema 与 llmOutputSchema 对拍守卫）"
fixtures: "tests/fixtures/stat-reference.json\n黄金基准集（容差 1e-9）"
jstat: "jstat@1.9.6（npm）\n仅用分布函数，本地 jstat.d.ts 最小类型声明"

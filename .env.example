# PostgreSQL 连接（本地开发默认值，提交到仓库作为示例）
DATABASE_URL=postgresql://postgres:PlatformDev2026@127.0.0.1:5432/fap
# API 服务端口
PORT=8787
# LLM 推理密钥（可选：缺失时 LLM 步骤降级为 skipped，不阻塞统计结果）
# qwen 系模型（DashScope OpenAI 兼容端点）
DASHSCOPE_API_KEY=
# deepseek 系模型
DEEPSEEK_API_KEY=
# 可选：自托管/代理端点覆盖
# LLM_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# T18 安全基线（可选）
# CORS Origin 白名单（逗号分隔；缺省同源，开发经 Vite 代理无需配置）
# CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
# 固定窗口限流（按 IP）
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX=300

# T20 部署（同源静态托管，可选；未设置 → 纯 API 模式）
# 相对 api 服务 cwd 或绝对路径，指向 apps/web 的 vite 产物
# WEB_DIST_DIR=../../apps/web/dist
